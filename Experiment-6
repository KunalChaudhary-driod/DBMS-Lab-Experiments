-- 6. Create Salary Validation Trigger
-- Reject employee insertions with salary below 15000

DELIMITER //

CREATE TRIGGER validate_employee_salary
BEFORE INSERT ON Employee
FOR EACH ROW
BEGIN
    IF NEW.salary < 15000 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Salary must be at least 15000';
    END IF;
END //

DELIMITER ;


-- 7. Test Salary Validation
-- This insertion should fail because the salary is below 15000

INSERT INTO Employee
    (emp_id, emp_name, gender, salary, hire_date, dept_id)
VALUES
    (131, 'Test Employee', 'M', 10000, '2026-09-25', 1);


-- 8. Test Valid Salary
-- This insertion should succeed because the salary is 30000

INSERT INTO Employee
    (emp_id, emp_name, gender, salary, hire_date, dept_id)
VALUES
    (131, 'Test Employee', 'M', 30000, '2026-09-25', 1);

-- Verify the inserted employee
SELECT
    emp_id,
    emp_name,
    salary
FROM Employee
WHERE emp_id = 131;


-- 9. Salary Validation Trigger for UPDATE
-- Reject salary updates below 15000

DELIMITER //

CREATE TRIGGER validate_employee_salary_update
BEFORE UPDATE ON Employee
FOR EACH ROW
BEGIN
    IF NEW.salary < 15000 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Salary must be at least 15000';
    END IF;
END //

DELIMITER ;


