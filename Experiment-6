-- 16. Edge Case: NULL Salary
-- Replace the insertion trigger so it rejects NULL salaries too

DROP TRIGGER validate_employee_salary;

DELIMITER //

CREATE TRIGGER validate_employee_salary
BEFORE INSERT ON Employee
FOR EACH ROW
BEGIN
    IF NEW.salary IS NULL OR NEW.salary < 15000 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
            'Salary cannot be NULL and must be at least 15000';
    END IF;
END //

DELIMITER ;


-- Test insertion with NULL salary
